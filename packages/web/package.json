{
  "name": "@heedwork/web",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/integry/heed.git",
    "directory": "packages/web"
  },
  "files": [
    "dist",
    "library/dist",
    "src/tokens.css",
    "src/fonts"
  ],
  "exports": {
    ".": {
      "types": "./library/dist/index.d.ts",
      "import": "./library/dist/index.js"
    },
    "./styles.css": "./library/dist/styles.css",
    "./tokens.css": "./src/tokens.css",
    "./dist/*": "./dist/*",
    "./*": "./dist/*"
  },
  "scripts": {
    "build": "vite build && vite build --mode library && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "d3-force": "^3.0.1",
    "d3-hierarchy": "^3.1.3",
    "d3-selection": "^3.0.1",
    "d3-zoom": "^3.0.1",
    "@heedwork/core": "0.1.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/d3-force": "^3.0.10",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/d3-selection": "^3.0.12",
    "@types/d3-zoom": "^3.0.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^31.0.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^4.1.0"
  },
  "peerDependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
