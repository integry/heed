# Copy to .dev.vars for local development.
# Register http://localhost:8787/auth/callback as a redirect URI for your Google
# OAuth web client. For a deployment, register its HTTPS /auth/callback URL.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Generate a separate secret for each environment with: openssl rand -hex 32
SESSION_SECRET=

# Set a separate secret (openssl rand -hex 32) to enable the token bootstrap.
# With Wrangler running, use npm run token:create -- "Build agent" report
ADMIN_SECRET=

# Approximate per-token request limit per minute (1–1000, defaults to 60).
# TOKEN_RATE_LIMIT_PER_MINUTE=60

# Comma-separated Google account emails. An empty list denies Google sign-ins.
ALLOWED_EMAILS=

# Optional local shortcut at http://localhost:8787/auth/dev-login.
# Requires SESSION_SECRET and bypasses Google and ALLOWED_EMAILS.
# DEV_LOGIN_EMAIL=dev@example.test
