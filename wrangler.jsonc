{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "heed",
  "main": "packages/engine/src/worker.ts",
  "compatibility_date": "2026-08-15",
  "assets": {
    "directory": "./packages/web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/auth/*",
      "/ws",
      "/mcp",
      "/.well-known/oauth-authorization-server",
      "/.well-known/oauth-protected-resource",
      "/.well-known/oauth-protected-resource/mcp",
    ],
  },
  // Uncomment to use Workers AI for commands or Whisper transcription.
  // "ai": { "binding": "AI" },
  "durable_objects": {
    "bindings": [{ "name": "WORKSPACE", "class_name": "Workspace" }],
  },
  "ratelimits": [
    {
      "name": "TOKEN_RATE_LIMITER",
      "namespace_id": "1001",
      // Requests are weighted in agent-auth.ts using TOKEN_RATE_LIMIT_PER_MINUTE.
      "simple": { "limit": 1000000, "period": 60 },
    },
  ],
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Workspace"] }],
}
